# Copy to `.env` at the repository root: `cp .env.example .env`
# The API loads this file via `envFilePath` (`apps/api` tries `.env` then `../../.env`).

# PostgreSQL (matches root docker-compose postgres service)
DATABASE_URL=postgresql://streamora:streamora@localhost:5432/streamora

# Redis (local docker-compose)
REDIS_URL=redis://localhost:6379

# NestJS API
PORT_API=3001

# OIDC issuer URL (Keycloak realm must exist; default assumes realm name `streamora`)
KEYCLOAK_ISSUER=http://localhost:8080/realms/streamora

# Browser origin allowed for GCS resumable upload session initiation
UPLOAD_RESUMABLE_ORIGIN=http://localhost:3000

# Worker + GCP (Pub/Sub / GCS — create resources in GCP first; see README “Worker & GCP”)
# GCP_PROJECT_ID=your-gcp-project-id
# PUBSUB_TOPIC_VIDEO_UPLOADED=video.uploaded
# PUBSUB_SUBSCRIPTION_VIDEO_UPLOADED=video-uploaded-dev-sub
# GCS_BUCKET_THUMBS=your-thumbs-bucket
# GCS_BUCKET_RENDITIONS=your-renditions-bucket
