# Copy to `.env` at the repository root: `cp .env.example .env`
# The API loads this file via `envFilePath` (`apps/api` tries `.env` then `../../.env`).

# PostgreSQL (matches root docker-compose postgres service)
DATABASE_URL=postgresql://streamora:streamora@localhost:5432/streamora

# Redis (local docker-compose)
REDIS_URL=redis://localhost:6379

# NestJS API
PORT_API=3001

# Clerk JWT validation (API only — see docs/clerk-setup.md)
# Derive from your Clerk instance, e.g. https://<instance>.clerk.accounts.dev
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_AUDIENCE=streamora-api
CLERK_SECRET_KEY=sk_test_...

# Cloud Scheduler secret for POST /admin/scheduler/publish-due
SCHEDULER_SECRET=change-me-in-production
# Set false in production (use Cloud Scheduler instead of in-process cron)
ENABLE_INTERNAL_CRON=true

# Browser origin allowed for GCS resumable upload session initiation
UPLOAD_RESUMABLE_ORIGIN=http://localhost:3000

# Comma-separated CORS origins (production: https://streamora.app)
ALLOWED_ORIGINS=http://localhost:3000

# Public asset CDN (optional; falls back to GCS direct URLs)
# CDN_BASE_URL=https://cdn.streamora.app
# APP_BASE_URL=https://streamora.app

# Worker + GCP (Pub/Sub / GCS — create resources in GCP first; see README)
# GCP_PROJECT_ID=your-gcp-project-id
# PUBSUB_TOPIC_VIDEO_UPLOADED=video.uploaded
# PUBSUB_SUBSCRIPTION_VIDEO_UPLOADED=video-uploaded-dev-sub
# PUBSUB_TOPIC_MEDIA_UPLOADED=media.uploaded
# PUBSUB_SUBSCRIPTION_MEDIA_UPLOADED=media-uploaded-dev-sub
# MEDIA_BUCKET=streamora-media
# GCS_BUCKET_ORIGINALS=your-originals-bucket
# GCS_BUCKET_THUMBS=your-thumbs-bucket
# GCS_BUCKET_RENDITIONS=your-renditions-bucket
