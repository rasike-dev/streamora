# Streamora production environment reference
# Store actual values in GCP Secret Manager — never commit secrets.

# --- Domains ---
NEXT_PUBLIC_APP_URL=https://streamora.app
NEXT_PUBLIC_API_URL=https://api.streamora.app
ALLOWED_ORIGINS=https://streamora.app
UPLOAD_RESUMABLE_ORIGIN=https://streamora.app
APP_BASE_URL=https://streamora.app
CDN_BASE_URL=https://cdn.streamora.app

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWKS_URL=https://clerk.streamora.app/.well-known/jwks.json
CLERK_JWT_ISSUER=https://clerk.streamora.app
CLERK_JWT_AUDIENCE=streamora-api

# --- Database (Cloud SQL via private IP + connector) ---
DATABASE_URL=postgresql://streamora:PASSWORD@/streamora?host=/cloudsql/PROJECT:REGION:streamora-prod

# --- GCS ---
GCP_PROJECT_ID=slpolinet-prod
GCS_BUCKET_ORIGINALS=slpolinet-originals-prod
GCS_BUCKET_THUMBS=slpolinet-thumbs-prod
GCS_BUCKET_RENDITIONS=slpolinet-renditions-prod
MEDIA_BUCKET=slpolinet-renditions-prod

# --- Pub/Sub ---
PUBSUB_TOPIC_VIDEO_UPLOADED=video.uploaded
PUBSUB_SUBSCRIPTION_VIDEO_UPLOADED=video-uploaded-prod-sub

# --- Scheduler ---
SCHEDULER_SECRET=generate-long-random-string
ENABLE_INTERNAL_CRON=false

# --- Redis (optional) ---
# REDIS_HOST=10.x.x.x
