# SLPoliNet production environment reference
# Local copy: `.env.production` at repo root (gitignored)
# Store live secrets in GCP Secret Manager — never commit secrets.

# --- Domains ---
NEXT_PUBLIC_APP_URL=https://slpolinet.com
NEXT_PUBLIC_API_URL=https://api.slpolinet.com
ALLOWED_ORIGINS=https://slpolinet.com,https://www.slpolinet.com
UPLOAD_RESUMABLE_ORIGIN=https://slpolinet.com
APP_BASE_URL=https://slpolinet.com
# CDN_BASE_URL=https://cdn.slpolinet.com

# --- Clerk (production instance) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWKS_URL=https://clerk.slpolinet.com/.well-known/jwks.json
CLERK_JWT_ISSUER=https://clerk.slpolinet.com
CLERK_JWT_AUDIENCE=streamora-api
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/en/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/en/dashboard

# --- Database (Cloud SQL socket on Cloud Run) ---
DATABASE_URL=postgresql://streamora:PASSWORD@localhost/streamora?host=/cloudsql/slpolinet-prod:us-central1:streamora-prod

# --- GCS ---
GCP_PROJECT_ID=slpolinet-prod
GCS_BUCKET_ORIGINALS=slpolinet-originals-prod
GCS_BUCKET_THUMBS=slpolinet-thumbs-prod
GCS_BUCKET_RENDITIONS=slpolinet-renditions-prod
MEDIA_BUCKET=slpolinet-renditions-prod

# --- Pub/Sub ---
PUBSUB_TOPIC_VIDEO_UPLOADED=video.uploaded
PUBSUB_TOPIC_MEDIA_UPLOADED=media.uploaded
PUBSUB_SUBSCRIPTION_VIDEO_UPLOADED=video-uploaded-prod-sub
PUBSUB_SUBSCRIPTION_MEDIA_UPLOADED=media-uploaded-prod-sub

# --- Scheduler ---
SCHEDULER_SECRET=generate-long-random-string
ENABLE_INTERNAL_CRON=false

# --- Cloud Run (deploy reference) ---
# REGION=us-central1
# IMAGE_TAG=local-demo1
# REGISTRY=us-central1-docker.pkg.dev/slpolinet-prod/streamora
