{
  "name": "streamora",
  "version": "0.0.1",
  "private": true,
  "description": "GCP Self-Managed Video Uploading Platform",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev": "concurrently -n WEB,API,WORKER \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "lint": "pnpm --filter api lint:check && pnpm --filter web lint",
    "build": "pnpm --filter api exec prisma generate && pnpm --filter api build && pnpm --filter web build && pnpm --filter worker build",
    "test": "pnpm --filter api test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402"
}
