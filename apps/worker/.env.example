# Copy to apps/worker/.env (or symlink ../../.env from repo root).

# Same Postgres as the API (worker updates Video / ProcessingJob via Prisma)
DATABASE_URL=postgresql://streamora:streamora@localhost:5432/streamora

GCP_PROJECT_ID=your-gcp-project-id

# Topic name must match what the API publishes to (PUBSUB_TOPIC_VIDEO_UPLOADED).
PUBSUB_TOPIC_VIDEO_UPLOADED=video.uploaded

# Subscription must exist in GCP before the worker starts (create via gcloud — see README).
PUBSUB_SUBSCRIPTION_VIDEO_UPLOADED=video-uploaded-dev-sub

# Media uploads (images & documents) — topic must match API PUBSUB_TOPIC_MEDIA_UPLOADED.
PUBSUB_TOPIC_MEDIA_UPLOADED=media.uploaded
PUBSUB_SUBSCRIPTION_MEDIA_UPLOADED=media-uploaded-dev-sub

GCS_BUCKET_THUMBS=your-thumbs-bucket
GCS_BUCKET_RENDITIONS=your-renditions-bucket
MEDIA_BUCKET=streamora-media

# Required for Pub/Sub + GCS when IAM was granted to a service account (not your user).
# Use an absolute path. The key's client_email must match the SA you granted Subscriber.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/streamora-uploader-key.json
