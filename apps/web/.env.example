# Copy to `apps/web/.env.local` — Next.js reads env files from this app directory.
# `NEXT_PUBLIC_*` values are exposed to the browser.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (see docs/clerk-setup.md)
# Pull real keys: clerk auth login && clerk env pull
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Locale-aware Clerk routes (match apps/web/src/app/[locale]/sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/en/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/en/dashboard

# Optional contact email for landing page CTA
# NEXT_PUBLIC_CONTACT_EMAIL=hello@streamora.app
