generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CreatorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoStatus {
  DRAFT
  UPLOADED
  PROCESSING
  PROCESSING_FAILED
  READY
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  TAKEDOWN
  ARCHIVED
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum VideoAnalyticsEventType {
  IMPRESSION
  PLAY_START
  HEARTBEAT
  PLAY_COMPLETE
}

enum VideoTrafficSource {
  DIRECT
  SHARE
  CHANNEL
  TAG
  SEARCH
  EXTERNAL
  UNKNOWN
}

enum UploadStatus {
  INITIATED
  UPLOADING
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  keycloakSub   String   @unique
  email         String?
  username      String?
  displayName   String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles         UserRole[]
  creatorProfile CreatorProfile?
  videos        Video[] @relation("UploaderVideos")
  shortLinks    ShortLink[]

  @@index([keycloakSub])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model CreatorProfile {
  id            String @id @default(cuid())
  userId        String @unique
  approval      CreatorApprovalStatus @default(PENDING)
  notes         String?
  dailyUploadLimitMinutes Int? // optional quota
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos    VideoChannel[]
  translations ChannelTranslation[]

  @@index([slug])
  @@index([isActive])
}

model ChannelTranslation {
  id        String @id @default(cuid())
  channelId String
  locale    String // en | si | ta
  name      String
  description String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, locale])
  @@index([locale])
}

model Tag {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  preferred  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos     VideoTag[]
  translations TagTranslation[]

  @@index([slug])
}

model TagTranslation {
  id          String   @id @default(cuid())
  tagId       String
  locale      String
  name        String
  description String?

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([locale])
}

model Video {
  id              String    @id @default(cuid())
  slug            String    @unique
  status          VideoStatus @default(DRAFT)
  visibility      VideoVisibility @default(PRIVATE)
  publishAt       DateTime?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  scheduleRequested Boolean @default(false)
  uploaderId      String?
  uploaderVisible Boolean   @default(false) // stays false until creator approved (your rule)
  
  // Moderation fields
  rejectionReason String?
  rejectionNote   String?
  rejectedAt      DateTime?
  rejectedBy      String?
  resubmittedAt   DateTime?
  moderationVersion Int      @default(1)
  
  // Governance fields
  takedownReason  String?
  takedownNote    String?
  takenDownAt     DateTime?
  takenDownBy     String?
  archivedReason  String?
  archivedNote    String?
  archivedAt      DateTime?
  archivedBy      String?
  
  // Analytics denormalized fields
  analyticsViews      Int       @default(0)
  analyticsCompletions Int      @default(0)
  analyticsLastViewedAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  uploader   User? @relation("UploaderVideos", fields: [uploaderId], references: [id], onDelete: SetNull)

  translations VideoTranslation[]
  channels     VideoChannel[]
  tags         VideoTag[]
  uploadIntents UploadIntent[]
  asset        VideoAsset?
  thumbnails   VideoThumbnail[]
  renditions   VideoRendition[]
  jobs         ProcessingJob[]
  analyticsEvents VideoAnalyticsEvent[]
  analyticsDaily  VideoAnalyticsDaily[]
  shortLinks      ShortLink[]
  auditLogs       VideoAuditLog[]
  subtitles       VideoSubtitle[]

  @@index([status])
  @@index([visibility])
  @@index([publishAt])
  @@index([uploaderId])
}

model VideoTranslation {
  id          String @id @default(cuid())
  videoId     String
  locale      String // en | si | ta
  title       String?
  description String?
  tagline     String?
  audience    String? // later could be JSON/enum flags

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, locale])
  @@index([locale])
}

model VideoChannel {
  videoId   String
  channelId String

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([videoId, channelId])
  @@index([channelId])
}

model VideoTag {
  videoId String
  tagId   String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model UploadIntent {
  id          String       @id @default(cuid())
  videoId     String
  objectKey   String
  bucket      String
  contentType String
  sizeBytes   BigInt
  status      UploadStatus @default(INITIATED)

  // Progress tracking
  uploadedBytes BigInt     @default(0)
  lastError     String?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
}

model VideoAsset {
  id          String   @id @default(cuid())
  videoId     String   @unique
  bucket      String
  originalKey String
  contentType String
  sizeBytes   BigInt
  durationSec Float?   // filled later by ffprobe
  width       Int?
  height      Int?
  hlsBucket    String?
  hlsMasterKey String?  // e.g. renditions/{videoId}/master.m3u8
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([bucket])
}

enum ThumbnailSource {
  AUTO
  CUSTOM
}

model VideoThumbnail {
  id          String           @id @default(cuid())
  videoId     String
  bucket      String
  objectKey   String
  width       Int?
  height      Int?
  timeSec     Float?          // timestamp used for the frame
  isSelected  Boolean          @default(false)
  source      ThumbnailSource  @default(AUTO)
  createdAt   DateTime         @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([videoId, isSelected])
  @@index([videoId, createdAt])
}

model VideoRendition {
  id          String   @id @default(cuid())
  videoId     String
  quality     String   // "360p" | "720p" etc.
  playlistKey String   // path to variant playlist (or master for quality)
  bandwidth   Int?
  width       Int?
  height      Int?
  codec       String?

  createdAt   DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@unique([videoId, quality])
}

enum JobStatus {
  PENDING
  RUNNING
  FAILED
  SUCCEEDED
}

model ProcessingJob {
  id            String    @id @default(cuid())
  videoId       String
  uploadIntentId String?
  jobType       String    // "THUMBS_HLS"
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  lastError     String?
  correlationId String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
}

model VideoAnalyticsEvent {
  id             String                   @id @default(cuid())
  videoId         String
  eventType       VideoAnalyticsEventType
  trafficSource   VideoTrafficSource      @default(UNKNOWN)

  sessionId       String
  viewerHash      String?
  locale          String?

  progressPercent Float?
  positionSeconds Float?
  durationSeconds Float?

  referrerHost    String?
  userAgent       String?
  ipHash          String?

  createdAt       DateTime                @default(now())

  video           Video                   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([videoId, eventType, createdAt])
  @@index([videoId, sessionId])
}

model VideoAnalyticsDaily {
  id               String              @id @default(cuid())
  videoId           String
  date              DateTime

  views             Int                 @default(0)
  uniqueViewers     Int                 @default(0)
  playStarts        Int                 @default(0)
  completions       Int                 @default(0)

  directViews       Int                 @default(0)
  shareViews        Int                 @default(0)
  channelViews      Int                 @default(0)
  tagViews          Int                 @default(0)
  searchViews       Int                 @default(0)
  externalViews     Int                 @default(0)
  unknownViews      Int                 @default(0)

  lastViewedAt      DateTime?

  video             Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, date])
  @@index([videoId, date])
}

model ShortLink {
  id              String   @id @default(cuid())
  code            String   @unique
  videoId         String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([code])
}

enum VideoAuditAction {
  VIDEO_CREATED
  VIDEO_SUBMITTED
  VIDEO_APPROVED
  VIDEO_REJECTED
  VIDEO_RESUBMITTED
  VIDEO_PUBLISHED
  VIDEO_TAKEDOWN
  VIDEO_ARCHIVED
  VIDEO_RESTORED
}

model VideoAuditLog {
  id          String           @id @default(cuid())
  videoId     String
  action      VideoAuditAction
  actorUserId String
  metadata    Json?
  createdAt   DateTime         @default(now())

  video       Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([action, createdAt])
}

enum SubtitleFormat {
  VTT
  SRT
}

model VideoSubtitle {
  id         String         @id @default(cuid())
  videoId    String
  locale     String
  format     SubtitleFormat @default(VTT)
  bucket     String
  objectKey  String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  video      Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, locale])
  @@index([videoId])
}
